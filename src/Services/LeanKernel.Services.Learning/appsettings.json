{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "LeanKernel": "Debug",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=leankernel.db"
  },
  "OpenAI": {
    "BaseUrl": "http://localhost:4000/v1",
    "ApiKey": "",
    "DefaultModel": "gpt-4o-mini",
    "ToolModel": "gpt-4o",
    "Memory": {
      "Enabled": true,
      "ModelId": "gpt-4o-mini",
      "MaxTokensPerPage": 2000,
      "MaxPages": 100
    },
    "FactExtraction": {
      "ModelId": "gpt-4o-mini",
      "Temperature": 0.1,
      "MaxOutputTokens": 1024
    }
  },
  "GBrain": {
    "BaseUrl": "http://gbrain:8789",
    "AuthToken": "",
    "TimeoutSeconds": 30
  },
  "Learning": {
    "Enabled": true,
    "TurnQueueCapacity": 1000,
    "MaxConcurrency": 1
  },
  "Scheduler": {
    "Enabled": true,
    "PollIntervalSeconds": 30,
    "DreamLockTimeoutSeconds": 300,
    "DefaultDreamMode": "full"
  }
}
